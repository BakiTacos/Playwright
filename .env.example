# Shopee Seller Center Base URL
# Examples:
# https://seller.shopee.vn   (Vietnam)
# https://seller.shopee.ph   (Philippines)
# https://seller.shopee.sg   (Singapore)
# https://seller.shopee.com.my (Malaysia)
# https://seller.shopee.co.id (Indonesia)
# https://seller.shopee.co.th (Thailand)
# https://seller.shopee.com.br (Brazil)
SHOPEE_BASE_URL=https://seller.shopee.vn

# Run browser in headless mode (true for background/server, false for visual debugging)
HEADLESS=false

# How often to check products if timers cannot be parsed (in minutes)
CHECK_INTERVAL_MINUTES=15
