# UMN Elearning Configuration
ELEARNING_BASE_URL=https://elearning.umn.ac.id

# Optional automated login credentials (if left blank, use 'npm run login' for interactive browser login)
UMN_USERNAME=
UMN_PASSWORD=

# Browser options
HEADLESS=false
BROWSER_TIMEOUT=45000

# Storage state path (session cookies)
STORAGE_STATE_PATH=./storageState.json

# Output settings
OUTPUT_DIR=./output
EXPORT_CSV=true
EXPORT_JSON=true
